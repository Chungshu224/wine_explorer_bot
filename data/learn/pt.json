":["f-porto-tawny","f-porto-lbv","f-porto-ruby","f-douro","f-tejo","f-alentejo"],"t":["blind_clue","tf_style"]},"f-douro":{"k":"style","q":"Douro\n\n風格特徵？","a":"Red: often powerful/structured historically, changing to more elegant styles. Tinta Roriz: juicy…","d":["f-porto-lbv","f-porto-ruby","f-vinho-verde","f-porto-tawny","f-lisboa","f-madeira-fort"],"t":["blind_clue","tf_style"]},"f-dao":{"k":"style","q":"Dão\n\n風格特徵？","a":"Red: Richer and fuller body than Douro. Touriga Nacional: blackberries, cassis, violets, bergamot…","d":["f-bairrada","f-lisboa","f-pt-fortified","f-tejo","f-madeira-estufa","f-porto-tawny"],"t":["blind_clue","tf_style"]},"f-bairrada":{"k":"style","q":"Bairrada\n\n風格特徵？","a":"Baga: late ripening, firm structure, high acid, red fruit, plums, cherries…","d":["f-dao","f-peninsula-de-setubal","f-madeira-estufa","f-algarve","f-vinho-verde","f-porto-lbv"],"t":["blind_clue","tf_style"]},"f-tejo":{"k":"style","q":"Tejo\n\n風格特徵？","a":"Mostly fruiter style for early consumption. Exuberant fruit forward…","d":["f-peninsula-de-setubal","f-pt-fortified","f-lisboa","f-vinho-verde","f-porto-lbv","f-porto-ruby"],"t":["blind_clue","tf_style"]},"f-peninsula-de-setubal":{"k":"style","q":"Península de Setúbal\n\n風格特徵？","a":"Castelão: can be rustic/uninteresting if high yielding, from old vines on sandy soils phenomenal…","d":["f-tejo","f-lisboa","f-pt-fortified","f-madeira-fort","f-vinho-verde","f-douro"],"t":["blind_clue","tf_style"]},"f-alentejo":{"k":"style","q":"Alentejo\n\n風格特徵？","a":"Generally described as New World in style (exuberant fruit, structure, vibrancy, freshness)…","d":["f-lisboa","f-dao","f-madeira-fort","f-douro","f-peninsula-de-setubal","f-madeira-estufa"],"t":["blind_clue","tf_style"]},"f-lisboa":{"k":"style","q":"Lisboa\n\n風格特徵？","a":"Bucelas: high acid. Wines tend to be good to very good.","d":["f-tejo","f-peninsula-de-setubal","f-pt-fortified","f-porto-lbv","f-alentejo","f-madeira-fort"],"t":["blind_clue","tf_style"]},"f-algarve":{"k":"style","q":"Algarve\n\n風格特徵？","a":"Mediterranean. Very sunny (~3000 hrs). Almost like an extension of Alentejo climate.","d":["f-madeira-estufa","f-porto-lbv","f-alentejo","f-pt-fortified","f-tejo","f-dao"],"t":["blind_clue","tf_style"]},"f-porto-tawny":{"k":"style","q":"Tawny 的木桶陳年\n與標示年份？","a":"氧化熟成於木桶\n基本款至少 3 年\n標示年份：10／20／30／40 年\nColheita：單一年份，至少 7 年","d":["f-douro","f-porto-lbv","f-porto-ruby","f-vinho-verde","f-peninsula-de-setubal","f-alentejo"],"t":["blind_clue","tf_style"]},"f-porto-lbv":{"k":"style","q":"LBV 與 Vintage Port\n的差別？","a":"LBV：收成後 4–6 年裝瓶\nVintage：宣告年份，桶陳約 2.5 年內\n裝瓶後可陳放數十年","d":["f-porto-ruby","f-vinho-verde","f-porto-tawny","f-douro","f-bairrada","f-dao"],"t":["blind_clue","tf_style"]},"f-porto-ruby":{"k":"style","q":"Ruby 與 Reserve Ruby？","a":"Ruby：不鏽鋼槽／大槽陳年，避免氧化，年輕\nReserve：高級 Ruby，須通過 IVDP 品評小組","d":["f-douro","f-porto-lbv","f-vinho-verde","f-porto-tawny","f-algarve","f-tejo"],"t":["blind_clue","tf_style"]},"f-madeira-estufa":{"k":"style","q":"Estufagem 與 Canteiro\n的差別？","a":"Estufagem：人工加熱\n（Cuba de Calor 至少 90 天，常約 46°C，上限約 55°C）\nCanteiro：木桶放閣樓，靠自然熱，用於高品質酒","d":["f-madeira-fort","f-porto-tawny","f-porto-lbv","f-douro","f-vinho-verde","f-alentejo"],"t":["blind_clue","tf_style"]},"f-madeira-fort":{"k":"style","q":"Madeira 如何中止發酵？","a":"加入葡萄烈酒（約 96% vol.）\n成品酒精 17.5–21%\n由 IVBAM 認證並發給封印","d":["f-madeira-estufa","f-porto-ruby","f-alentejo","f-vinho-verde","f-porto-lbv","f-douro"],"t":["blind_clue","tf_style"]},"f-pt-fortified":{"k":"style","q":"里斯本周邊\n哪兩個 DOC 是加烈酒？","a":"Carcavelos\nSetúbal（Moscatel de Setúbal）","d":["f-peninsula-de-setubal","f-lisboa","f-tejo","f-porto-lbv","f-vinho-verde","f-alentejo"],"t":["blind_clue","tf_style"]}}}